# Copy to .env and edit. Never commit real secrets. All values below are placeholders.
NODE_ENV=development
PORT=3001
# Public base URL used in certificate verification links / QR codes
PUBLIC_URL=http://localhost:3001
# SQLite file and private upload directory (outside any public static path)
DATABASE_PATH=./data/kavli.db
UPLOAD_DIR=./data/uploads
# Seed demo accounts + sample content on an empty DB. Set 0 in production.
SEED_DEMO=1
# Tutor provider: "anthropic" when a key is set, otherwise the labelled development tutor
AI_PROVIDER=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
# Test-only: disables the auth rate limiter
DISABLE_RATE_LIMIT=

# Voice tutor: max concurrent teaching requests and how long extra requests may queue (ms)
VOICE_MAX_CONCURRENCY=8
VOICE_QUEUE_MS=8000

# AI voice (optional). Without TTS_URL the tutor speaks with the student's browser voice.
# TTS_URL=https://your-tts-host/v1/audio/speech
# TTS_API_KEY=
# TTS_MODEL=
# TTS_VOICE_EN=
# TTS_VOICE_TA=
# TTS_FORMAT=mp3
# TTS_TIMEOUT_MS=12000
# TTS_MAX_CONCURRENCY=4
# VOICE_TTS_DAILY_CHARS=20000
# VOICE_AUDIO_CACHE_MB=24
