# Copy to .env and edit. Never commit real secrets. All values below are placeholders.
NODE_ENV=development
PORT=3001
# Public base URL used in certificate verification links / QR codes
PUBLIC_URL=http://localhost:3001

# --- Email (password reset, email confirmation, guardian approval) ---
# Links in mails are built from PUBLIC_URL only. Without a provider, mails are printed to the server log (dev) and the app says email is off.
# MAIL_DRIVER=resend|smtp|log   (auto: resend if RESEND_API_KEY, else smtp if SMTP_HOST, else log)
# MAIL_FROM="Kalvi Mitra <no-reply@your-domain.in>"
# RESEND_API_KEY=
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_SECURE=0
# Database. Production: PostgreSQL (DATABASE_URL). Local/dev: a SQLite file (DATABASE_PATH).
# DATABASE_URL=postgres://user:password@host:5432/kavli
# DATABASE_SSL=1            # managed Postgres (Neon, Supabase, RDS, Azure) usually needs this
# DATABASE_SSL_STRICT=1     # set 0 only if the provider's certificate chain cannot be verified
# DATABASE_POOL=10
DATABASE_PATH=./data/kavli.db

# File storage for textbook PDFs and student uploads.
# local (default): folders on a persistent disk.  s3: any S3-compatible bucket (AWS S3, Cloudflare R2, Supabase Storage, MinIO).
STORAGE_DRIVER=local
TEXTBOOK_DIR=./data/textbooks
UPLOAD_DIR=./data/uploads
# S3_BUCKET=kavli-files
# S3_REGION=ap-south-1
# S3_ENDPOINT=              # only for non-AWS services, e.g. https://<account>.r2.cloudflarestorage.com
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PREFIX=prod

# Scanned / badly-encoded textbook pages are read with OCR (needs tesseract + Tamil data + poppler; the Docker image has them).
# OCR_ENGINE=off            # disable OCR
# OCR_TESSDATA=             # folder with tam.traineddata / eng.traineddata if not in the system default
# OCR_CONCURRENCY=1
# Seed demo accounts + sample content on an empty DB. Set 0 in production.
SEED_DEMO=1
# Tutor model. With no key the labelled rule-based development tutor is used (nothing is sent anywhere).
# Anthropic:
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
# Or any OpenAI-compatible service (OpenAI, Azure OpenAI, vLLM, Ollama...):
# LLM_PROVIDER=openai
# LLM_BASE_URL=https://your-host/v1
# LLM_API_KEY=
# LLM_MODEL=
# LLM_TIMEOUT_MS=25000      # slower than this -> the rule-based lesson is used for that question
AI_PROVIDER=
# Test-only: disables the auth rate limiter
DISABLE_RATE_LIMIT=

# Voice tutor: max concurrent teaching requests and how long extra requests may queue (ms)
VOICE_MAX_CONCURRENCY=8
VOICE_QUEUE_MS=8000

# AI voice (optional). Without a voice service the tutor speaks with the student's browser voice.
# Azure AI Speech (recommended; Tamil and English neural voices):
# AZURE_SPEECH_KEY=
# AZURE_SPEECH_REGION=centralindia
# AZURE_SPEECH_VOICE_TA=ta-IN-PallaviNeural
# AZURE_SPEECH_VOICE_EN=en-IN-NeerjaNeural
# Or any OpenAI-style speech service:
# TTS_URL=https://your-tts-host/v1/audio/speech
# TTS_API_KEY=
# TTS_MODEL=
# TTS_VOICE_EN=
# TTS_VOICE_TA=
# TTS_FORMAT=mp3
# TTS_TIMEOUT_MS=12000
# TTS_MAX_CONCURRENCY=4
# VOICE_TTS_DAILY_CHARS=20000
# VOICE_AUDIO_CACHE_MB=24
