{
  "name": "kavli",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm:server\" \"vite\"",
    "server": "tsx watch server/index.ts",
    "start": "NODE_ENV=production tsx server/index.ts",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b && tsc -p tsconfig.server.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1158.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/noto-sans": "^5.3.0",
    "@fontsource/noto-sans-tamil": "^5.3.0",
    "express": "^4.22.3",
    "multer": "^2.5.0",
    "pdf-parse": "^2.4.5",
    "pdfkit": "^0.20.2",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^4.17.25",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.5",
    "@types/pdfkit": "^0.17.7",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^4.3.1",
    "axe-core": "^4.14.0",
    "concurrently": "^10.0.6",
    "embedded-postgres": "^18.4.0-beta.17",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^5.5.4",
    "vite": "^5.4.8",
    "vitest": "^2.1.9"
  }
}
